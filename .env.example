# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for trusted administrative operations; never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://lenxiq.online

# Server-side AI and payments (keep private)
GEMINI_API_KEY=
GEMINI_TEACHING_MODEL=gemini-3.8-flash
GEMINI_EXPLAIN_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
FLW_SECRET_KEY=

# LiveKit Cloud configuration shared by Next.js and the Modal Pipecat worker.
# Use the exact values stored in Modal Secret `livekit-credentials`.
LIVEKIT_PUBLIC_URL=wss://lensiq-ai-03b9brz7.livekit.cloud
LIVEKIT_URL=wss://lensiq-ai-03b9brz7.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional legacy browser variable; do not point it at an old Codespaces URL.
NEXT_PUBLIC_LIVEKIT_URL=
# Leave blank for Modal room polling; internal URLs are only for colocated dispatch.
LIVEKIT_INTERNAL_URL=
LIVEKIT_SELF_HOSTED_URL=
LIVEKIT_AGENT_URL=
# Modal Pipecat agent name and no-paid-provider dispatch mode.
LIVEKIT_AGENT_NAME=lensiq-voice-tutor
LIVEKIT_DISPATCH_MODE=room-poll
MODAL_APP_NAME=lenxiq-ai-voice

  "livekit_worker_notes": {
    "source": "worker/lensiq-voice-tutor/agent.py",
    "deployment_workflow": ".github/workflows/deploy-voice-worker.yml",
    "current_target_from_source": "LiveKit Cloud; the deploy workflow updates an existing CA_ agent and requires production-voice-worker configuration. No deployment was performed in Phase 1.",
    "process": "Long-running Python LiveKit Agents server packaged in Docker. This process must remain on LiveKit Cloud Agents; it is not a Cloudflare Workers process.",
    "python_packages": [
      "livekit-agents==1.8.13",
      "httpx>=0.27,<1",
      "python-dotenv>=1,<2"
    ],
    "speech_from_source": "LiveKit inference STT default deepgram/nova-3 (LENXIQ_STT_MODEL override), and inference TTS cartesia/sonic-3.6. The current worker does not use Kokoro despite an obsolete comment in the web gateway.",
    "reasoning_from_source": "Server-side Gemini lesson brain; web speech gateway defaults to Groq and falls back to Gemini. Inspect actual source and provider configuration before changing the product stack.",
    "phase_2_updates": [
      "Set the independent agent dispatch name and web origin for Cortex; retain signed session/user/room tokens and 90-minute expiry.",
      "Port web routes through @opennextjs/cloudflare after verifying LiveKit server SDK and node:crypto compatibility.",
      "Retain Supabase Postgres and Storage with owner-scoped access; no R2.",
      "Review whether Groq must be replaced to meet the new Gemini API product requirement; do not change the existing Study Hub voice stack during Phase 1.",
      "Do not add Modal to Cortex."
    ]
  },
  "source_shell_adaptation": [
